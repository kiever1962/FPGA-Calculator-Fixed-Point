module keypad_decoder (
    input  logic        clk,
    input  logic        rst_n,
    input  logic [15:0] keys_stable,
    output logic        key_valid,
    output logic [3:0]  key_code,
    output logic        key_equal
);
    reg [15:0] keys_prev;
    logic [15:0] keys_pressed;
    
    // Визначаємо момент натискання (передній фронт стабільного сигналу)
    assign keys_pressed = keys_stable & ~keys_prev;

    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            keys_prev <= '0;
        end else begin
            keys_prev <= keys_stable;
        end
    end

    // Карта клавіатури (Приклад стандартного кейпаду 4х4):
    // Рядок 0: [1]=bit0,  [2]=bit1,  [3]=bit2,  [A]=bit3  ( Додавання -> 4'hC )
    // Рядок 1: [4]=bit4,  [5]=bit5,  [6]=bit6,  [B]=bit7  ( Віднімання -> 4'hD )
    // Рядок 2: [7]=bit8,  [8]=bit9,  [9]=bit10, [C]=bit11 ( Множення -> 4'hE )
    // Рядок 3: [*]=bit12, [0]=bit13, [#]=bit14, [D]=bit15 ( Ділення -> 4'hF, *=Крапка, #=Скинути 'C' )
    // Кнопка "Равно" (=) винесена окремо за вашою логікою, нехай це буде комбінація або окрема кнопка.
    // Для універсальності: зробимо клавішу [A] (bit3) кнопкою "Равно", а операції зсунемо.

    always_comb begin
        key_valid = 1'b0;
        key_equal = 1'b0;
        key_code  = 4'h0;

        if (keys_pressed != 16'h0) begin
            if (keys_pressed[13]) begin key_valid = 1'b1; key_code = 4'd0; end // '0'
            else if (keys_pressed[0])  begin key_valid = 1'b1; key_code = 4'd1; end // '1'
            else if (keys_pressed[1])  begin key_valid = 1'b1; key_code = 4'd2; end // '2'
            else if (keys_pressed[2])  begin key_valid = 1'b1; key_code = 4'd3; end // '3'
            else if (keys_pressed[4])  begin key_valid = 1'b1; key_code = 4'd4; end // '4'
            else if (keys_pressed[5])  begin key_valid = 1'b1; key_code = 4'd5; end // '5'
            else if (keys_pressed[6])  begin key_valid = 1'b1; key_code = 4'd6; end // '6'
            else if (keys_pressed[8])  begin key_valid = 1'b1; key_code = 4'd7; end // '7'
            else if (keys_pressed[9])  begin key_valid = 1'b1; key_code = 4'd8; end // '8'
            else if (keys_pressed[10]) begin key_valid = 1'b1; key_code = 4'd9; end // '9'
            
            else if (keys_pressed[12]) begin key_valid = 1'b1; key_code = 4'hA; end // '.' (Крапка)
            else if (keys_pressed[14]) begin key_valid = 1'b1; key_code = 4'hB; end // 'C' (Скидання)
            
            else if (keys_pressed[7])  begin key_valid = 1'b1; key_code = 4'hC; end // '+'
            else if (keys_pressed[11]) begin key_valid = 1'b1; key_code = 4'hD; end // '-'
            else if (keys_pressed[15]) begin key_valid = 1'b1; key_code = 4'hE; end // '*'
            else if (keys_pressed[14]) begin key_valid = 1'b1; key_code = 4'hF; end // '/'
            
            else if (keys_pressed[3])  begin key_equal = 1'b1; end // '=' (Кнопка Равно)
        end
    end
endmodule